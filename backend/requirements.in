# Direkte Abhängigkeiten des Backends.
# requirements.txt wird daraus erzeugt (alle Versionen festgeschrieben):
#   pip install pip-tools
#   pip-compile --strip-extras requirements.in
# Aktualisieren aller Pakete: pip-compile --upgrade --strip-extras requirements.in

# Grundgerüst
Django~=5.2.0                 # LTS, Sicherheitsupdates bis April 2028
djangorestframework
djangorestframework-camel-case
drf-nested-routers
django-filter
django-cors-headers
django-environ
django-extensions
drf-api-logger

# Login und Keycloak
