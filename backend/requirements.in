python-keycloak

# Hintergrundaufgaben
celery[redis]

# Dateien, Mails, Speicher
django-storages[s3]
django-ses
django-stdimage
Pillow
openpyxl

# Sonstige Funktionen
django-colorfield
# notifications: als eigenes Modul übernommen (backend/notifications), braucht:
jsonfield
django-model-utils
swapper
geopy
python-dateutil
pytz
requests

# Betrieb
gunicorn
psycopg2-binary
