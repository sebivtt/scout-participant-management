# Lokale Entwicklung: kopieren nach backend/backend/.env
# Lokale Entwicklungskonfiguration für das Backend (NICHT für den Echtbetrieb)
SECRET_KEY=dev-only-not-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGIN_WHITELIST=http://localhost:8080,http://127.0.0.1:8080

USE_RDS_DB=True
RDS_DB_NAME=scout
RDS_USERNAME=scout
RDS_PASSWORD=scout
RDS_HOSTNAME=localhost
RDS_PORT=5432
# Lokal ohne SSL-Zertifikat. Im Echtbetrieb weglassen (Standard: require).
DB_SSLMODE=disable

USE_S3=False
USE_SES=False
FRONT_URL=http://localhost:8080

USE_CELERY=False
CELERY_BROKER=redis://localhost:6379/0

BASE_URI=http://localhost:8180/
OIDC_RP_REALMNAME=dpv
OIDC_RP_CLIENT_ID=scout-frontend
OIDC_RP_CLIENT_SECRET_BACKEND=unused
KEYCLOAK_APP_REALM=dpv
KEYCLOAK_ADMIN_USER=scout-backend
KEYCLOAK_ADMIN_PASSWORD=dev-backend-secret
